{
  "name": "hms-workspace",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "dotnet run --project backend/src/HMS.Api --urls http://localhost:5080",
    "dev:web": "npm --prefix frontend/hms-web run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
